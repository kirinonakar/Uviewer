<UserControl
    x:Class="Uviewer.Controls.TextReaderControl"
    x:Name="TextReaderRoot"
    Visibility="{Binding Visibility, ElementName=TextArea, Mode=OneWay}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Uviewer"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="TextItemTemplate">
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="TextArea"
          Visibility="Collapsed"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          IsTabStop="False"
          PointerPressed="TextArea_PointerPressed"
          PointerMoved="TextArea_PointerMoved"
          PointerReleased="TextArea_PointerReleased"
          PointerCanceled="TextArea_PointerReleased"
          PointerCaptureLost="TextArea_PointerReleased"
          PointerWheelChanged="TextArea_PointerWheelChanged"
          SizeChanged="TextArea_SizeChanged">
        <ScrollViewer x:Name="TextScrollViewer"
                      Margin="0,0,0,10"
                      Padding="20,10,20,10"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Top"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      SizeChanged="TextScrollViewer_SizeChanged"
                      ViewChanged="TextScrollViewer_ViewChanged">
            <ItemsRepeater x:Name="TextItemsRepeater"
                           ElementPrepared="TextItemsRepeater_ElementPrepared"
                           ItemTemplate="{StaticResource TextItemTemplate}"
                           Margin="0,0,0,40">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <canvas:CanvasControl x:Name="AozoraTextCanvas"
                              Visibility="Collapsed"
                              IsTabStop="False"
                              Draw="AozoraTextCanvas_Draw"
                              CreateResources="AozoraTextCanvas_CreateResources"
                              PointerPressed="AozoraTextCanvas_PointerPressed"
                              PointerMoved="AozoraTextCanvas_PointerMoved"
                              PointerReleased="AozoraTextCanvas_PointerReleased"
                              PointerCanceled="AozoraTextCanvas_PointerReleased"
                              PointerCaptureLost="AozoraTextCanvas_PointerReleased"
                              PointerWheelChanged="AozoraTextCanvas_PointerWheelChanged"
                              SizeChanged="AozoraTextCanvas_SizeChanged" />

        <Grid x:Name="TextFastNavOverlay"
              Canvas.ZIndex="999"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="#80000000"
                    CornerRadius="8"
                    Padding="24,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TextFastNavText"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="{x:Bind app:Strings.TextFastNavText}" />
            </Border>
        </Grid>

        <canvas:CanvasControl x:Name="VerticalTextCanvas"
                              Visibility="Collapsed"
                              IsTabStop="False"
                              Draw="VerticalTextCanvas_Draw"
                              CreateResources="VerticalTextCanvas_CreateResources"
                              PointerPressed="VerticalTextCanvas_PointerPressed"
                              PointerMoved="VerticalTextCanvas_PointerMoved"
                              PointerReleased="VerticalTextCanvas_PointerReleased"
                              PointerCanceled="VerticalTextCanvas_PointerReleased"
                              PointerCaptureLost="VerticalTextCanvas_PointerReleased"
                              PointerWheelChanged="VerticalTextCanvas_PointerWheelChanged"
                              SizeChanged="VerticalTextCanvas_SizeChanged" />
    </Grid>
</UserControl>
